<Window x:Class="TaskManagerMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManagerMVVM"
        mc:Ignorable="d"
        Title="MainWindow" Height="832" Width="1280"
        WindowStartupLocation = "CenterScreen"> 
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width ="80" />
            <ColumnDefinition Width ="435" />
            <ColumnDefinition Width ="1*" />
            <ColumnDefinition Width ="140" />
        </Grid.ColumnDefinitions>
        
        <!--Navpanel-->
        <Rectangle Fill="{StaticResource AccentDark}"  />
        <!--TaskListbackGround-->
        <Rectangle Fill="{StaticResource TaskListbackGround}" Grid.Column="1"/>
        <!--TaskListbackGround-->
        <Rectangle Fill="{StaticResource TaskStatusBackGround}" Grid.Column="2"/>
        <!--TaskListbackGround-->
        <Rectangle Fill="{StaticResource TaskStatusBackGround}" Grid.Column="3"/>

        <!--GridTaskColumn-->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>

                <RowDefinition Height="60" />
                <RowDefinition Height="38" />
                <RowDefinition Height="1*" />

            </Grid.RowDefinitions>

            <!--Task Label-->
            <Label Style ="{StaticResource Heading1}" Content="Tasks" 
                   IsHitTestVisible="False"
                   />

            <!--add task button-->
            <Button Style="{StaticResource RoundAccentButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Height="40"
                    Width="40"
                    Margin="0 0 20 0"
                    >
                <!--Icon-->
                <Viewbox>
                    <Path Data="{StaticResource NewTaskIcon}" Stretch="Fill" Width="200" Fill="{StaticResource OnAccent}"/>
                </Viewbox>
            </Button>

            <!--Search Task Bar-->
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource TaskListSearchBox}" Grid.Row="1"
                     Margin="20 0 "
                     />
            <Label IsHitTestVisible="False"
                   Content="Search Tasks..."
                   Grid.Row="1"
                   VerticalAlignment="Center"
                   Margin="40 0 0 0"
                   Foreground="{StaticResource Borders}"
                   Visibility="{Binding Text.IsEmpty, ElementName=SearchBox,Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Margin="0 0 40 0"
                    Padding="5">
                <Viewbox Width="22" Height="22">
                    <Path Data="{StaticResource SearchIcon}" Stretch="Fill"  Fill="#55666E" />
                </Viewbox> 
            </Button>
            <!--ListViewForTaskItems-->
            <ListView Grid.Row="2"
                Background="Transparent" 
                Margin="0 20"
                BorderBrush="Transparent">
            </ListView>

        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>

                <RowDefinition Height="238"  />
                <RowDefinition Height="1*"  />
                <RowDefinition Height="60"  />
            </Grid.RowDefinitions>
            <Grid Margin="20 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"  />
                    <RowDefinition Height="1*"  />
                    <RowDefinition Height="30"  />
                </Grid.RowDefinitions>

                <TextBlock Text="Task Title"
                           Style="{StaticResource Title}"
                           VerticalAlignment="Center"
                           />
                <Border HorizontalAlignment ="Right"
                        VerticalAlignment="Center"
                        Padding="20 5"
                        CornerRadius="5"
                        Background="{StaticResource Importance-Crit}"
                        >
                    <TextBlock Text="Critical"
                               FontWeight="Bold"
                               Foreground="{StaticResource OnAccent}"/>

                </Border>
                <!--Description Scrollbar-->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <!--Description-->
                        <TextBlock Text="Lorem ipsum dollor abcdefghijk 012345678910" 
                                 
                                 FontSize="16"
                                 Foreground="{StaticResource PalceHolderText}"
                                 Margin="0 20"/>
                </ScrollViewer>

                <!--Due Date-->
                <TextBlock Text="Due:17/12/2026"
                           Background="{StaticResource AccentDark}"
                           Padding="20 3"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Grid.Row="2"
                           Foreground="White"/>


            </Grid>


        </Grid>

    </Grid>

    

</Window>
